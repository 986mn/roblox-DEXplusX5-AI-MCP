{
  "name": "DEX++ MCP Bridge",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [
    16384
  ],
  "portsAttributes": {
    "16384": {
      "label": "DEX++ MCP Bridge",
      "onAutoForward": "silent",
      "visibility": "public",
      "protocol": "https"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "nohup bash .devcontainer/start.sh > /tmp/poststart.log 2>&1 &",
  "postAttachCommand": "bash .devcontainer/ensure-running.sh --quiet",
  "remoteUser": "node",
  "customizations": {
    "vscode": {
      "extensions": [
        "sumneko.lua",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
